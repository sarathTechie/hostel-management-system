{
  "name": "@hms/server", "private": true, "version": "1.0.0", "type": "module",
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx watch src/index.ts", "build": "tsc && node scripts/copy-prisma-client.mjs", "start": "dotenv -e ../.env -- node dist/src/index.js", "typecheck": "tsc --noEmit",
    "test": "vitest run", "db:generate": "dotenv -e ../.env -- prisma generate", "db:migrate": "dotenv -e ../.env -- prisma migrate dev", "db:deploy": "dotenv -e ../.env -- prisma migrate deploy", "db:seed": "dotenv -e ../.env -- tsx prisma/seed.ts", "db:demo-passwords": "dotenv -e ../.env -- node prisma/update-demo-passwords.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2", "argon2": "^0.44.0", "cookie-parser": "^1.4.7", "cors": "^2.8.5", "dotenv": "^16.6.1",
    "express": "^5.1.0", "express-rate-limit": "^8.1.0", "helmet": "^8.1.0", "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9", "@types/cors": "^2.8.19", "@types/express": "^5.0.3", "@types/node": "^24.5.2", "dotenv-cli": "^8.0.0", "prisma": "^6.16.2",
    "tsx": "^4.20.5", "typescript": "^5.9.2", "vitest": "^3.2.4", "supertest": "^7.1.4", "@types/supertest": "^6.0.3"
  }
}
